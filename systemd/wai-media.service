[Unit]
Description=WAI Telegram Background Media Worker
After=network.target docker.service wai-backend.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=wai
Group=wai
SupplementaryGroups=wai-media
WorkingDirectory=/opt/wai-telegram/packages/backend
Environment="PATH=/home/wai/.local/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/wai-telegram/.env.production

# Media is staged here only between download and text extraction, then deleted,
# so it no longer warrants a dedicated volume. Verify the directory is usable
# instead of demanding a separate mount.
ExecStartPre=/bin/sh -c 'test -w /srv/wai-telegram-media'
ExecStartPre=+/bin/sh -c 'n=0; until docker exec wai-telegram-redis redis-cli ping >/dev/null 2>&1; do n=$((n+1)); [ $n -ge 30 ] && exit 1; sleep 2; done'
ExecStart=/opt/wai-telegram/.venv/bin/celery -A app.tasks.celery_app:celery_app worker --hostname=media-fetch@%H --loglevel=info --queues=media-fetch --concurrency=1 --prefetch-multiplier=1

Restart=always
RestartSec=10
TimeoutStopSec=3600

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wai-media

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/opt/wai-telegram /srv/wai-telegram-media /tmp
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
